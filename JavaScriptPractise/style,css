body {
    font-family: Arial, sans-serif;
    background-color: lightgray;
}

.todo-container {
    width: 400px;
    margin: 100px auto;
    background-color: white;
    padding: 20px;
    border-radius: 10px;
}

h1 {
    text-align: center;
}

.input-box {
    display: flex;
    gap: 10px;
}

input {
    flex: 1;
    padding: 10px;
}

button {
    padding: 10px 15px;
    cursor: pointer;
}

li {
    margin-top: 10px;
    padding: 10px;
    background-color: lightblue;
    list-style: none;
}